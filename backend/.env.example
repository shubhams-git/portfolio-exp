PORT=8000
# Comma-separated browser origins allowed to call the API (your Vercel URL(s), no trailing slashes).
# Example: https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true on Render if you use Vercel preview URLs (https://*.vercel.app) and do not list each in ALLOWED_ORIGINS.
CORS_ALLOW_VERCEL_PREVIEW=false
CONTACT_RECEIVER=hello@example.com
# Optional but recommended: enable portfolio email notifications with Resend.
# For smoke testing you can use "Portfolio Contact <onboarding@resend.dev>" as CONTACT_EMAIL_FROM.
# For production, verify your domain in Resend and use something like "Shubham Sharma <hello@yourdomain.com>".
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_SUBJECT_PREFIX=[Portfolio Contact]
# On Render with a persistent disk mounted at /var/data, use /var/data/contact-submissions.ndjson.
CONTACT_STORAGE_PATH=data/contact-submissions.ndjson
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
TRUST_PROXY=true
